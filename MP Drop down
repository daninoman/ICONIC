// ==UserScript==
// @name         OWMS Automatic Shipping Provider
// @namespace    owms-shipping-provider
// @version      1.0.0
// @description  Selects the OWMS shipping provider using the vendor return postcode.
// @author       Layla Phillips
// @match        https://oms-live-au.zalora.net/bulk-express-checkout
// @grant        none
// @updateURL    
// @downloadURL  
// ==/UserScript==

(function () {
    "use strict";

    /*
     * IMPORTANT:
     * Replace the @match address above with the real OWMS address.
     *
     * Example:
     * @match https://owms.example.com/*
     */

